{
  "$schema": "https://turborepo.com/schema.json",
  "futureFlags": {
    "strictTaskEntrypointSelection": true
  },
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "types:check": {
      "cache": true,
      "dependsOn": ["transit"]
    },
    "lint:check": {
      "cache": false
    },
    "lint:fix": {
      "cache": false
    },
    "lint:actions:check": {
      "cache": false
    },
    "fmt:check": {
      "cache": false
    },
    "fmt:fix": {
      "cache": false
    },
    "knip:check": {
      "cache": false
    },
    "knip:fix": {
      "cache": false
    },
    "@supabase/docs#types:check": {
      "cache": true,
      "dependsOn": ["transit"],
      "outputs": [".source/**"]
    },
    "test:unit:run": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "test:integration:run": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "test:e2e:run": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "@dbase/cli#build": {
      "cache": true,
      "dependsOn": ["@supabase/config#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/mise.lock",
        "$TURBO_ROOT$/packages/api/**",
        "$TURBO_ROOT$/packages/stack/package.json",
        "$TURBO_ROOT$/packages/stack/src/**"
      ],
      "outputs": ["dist/**"]
    },
    "@supabase/config#build": {
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/mise.lock"],
      "outputs": ["dist/**"]
    },
    "@supabase/api#generate": {
      "cache": false,
      "outputs": ["src/generated/**", "scripts/openapi-source.json"],
      "env": ["SUPABASE_API_URL"]
    },
    "@supabase/stack#generate": {
      "cache": false,
      "outputs": ["src/functions/generated/**"]
    },
    "@supabase/docs#generate": {
      "cache": true,
      "dependsOn": ["@dbase/cli#build", "@supabase/config#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!content/docs/commands/**",
        "!public/schemas/**",
        "$TURBO_ROOT$/mise.lock"
      ],
      "outputs": ["content/docs/commands/**", "public/schemas/**"]
    },
    "@supabase/docs#build": {
      "cache": true,
      "dependsOn": ["generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!content/docs/commands/**",
        "!public/schemas/**",
        "$TURBO_ROOT$/mise.lock"
      ],
      "outputs": [".next/**"]
    },
    "@dbase/cli#test:live": {
      "cache": false,
      "dependsOn": ["@dbase/cli#build"],
      "passThroughEnv": ["*"]
    },
    "@supabase/cli-e2e#record": {
      "cache": false,
      "dependsOn": ["@dbase/cli#build"],
      "passThroughEnv": ["*"]
    },
    "@dbase/cli#test:smoke": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "@supabase/docs#dev": {
      "cache": false,
      "dependsOn": ["@supabase/docs#generate"],
      "persistent": true
    },
    "@dbase/cli#test:e2e:run": {
      "cache": false,
      "passThroughEnv": ["*"],
      "dependsOn": ["@dbase/cli#build"]
    },
    "@supabase/cli-e2e#test:e2e:run": {
      "cache": false,
      "passThroughEnv": ["*"],
      "dependsOn": ["@dbase/cli#build"]
    }
  }
}
